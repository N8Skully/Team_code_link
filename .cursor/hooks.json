{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/room_context.py",
        "timeout": 25
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/boundary.py",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/boundary.py",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
